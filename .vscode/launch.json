{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Jarvis: GUI starten",
            "type": "debugpy",
            "request": "launch",
            "module": "jarvis.main",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": false
        },
        {
            "name": "Jarvis: Konsolenmodus (ohne GUI)",
            "type": "debugpy",
            "request": "launch",
            "module": "jarvis.main",
            "args": ["--console"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": false
        },
        {
            "name": "Jarvis: Tests (pytest)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["jarvis/tests", "-v"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        },
        {
            "name": "Python: Aktuelle Datei",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": false
        }
    ]
}
