{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Jarvis: Einrichten (Text-Modus)",
            "detail": "Legt .venv an und installiert die leichten Pakete (anthropic, PySide6). Einmal ausführen.",
            "type": "shell",
            "command": "python3 -m venv .venv && .venv/bin/pip install --upgrade pip && .venv/bin/pip install -r requirements-text.txt",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Jarvis: GUI starten",
            "detail": "Startet die grafische Oberfläche (Textbedienung).",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python -m jarvis.main",
            "problemMatcher": []
        },
        {
            "label": "Jarvis: Tests ausführen",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python -m pytest jarvis/tests -v",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Jarvis: Voll-Setup (Sprache + Kamera)",
            "detail": "Optional: installiert zusätzlich Whisper, Piper, YOLO und lädt die Modelle.",
            "type": "shell",
            "command": "bash jarvis/setup.sh",
            "problemMatcher": []
        }
    ]
}
